# ─────────────────────────────────────────────────
# .env.example  –  copy to .env and fill in values
# ─────────────────────────────────────────────────

# Flask
FLASK_ENV=development
SECRET_KEY=change-me-to-a-long-random-string

# Gmail SMTP
# Use a Gmail App Password, NOT your real Gmail password.
# How to get one: https://support.google.com/accounts/answer/185833
GMAIL_ADDRESS=your-email@gmail.com
GMAIL_APP_PASSWORD=your-gmail-app-password

# OTP settings (optional — these are the defaults)
OTP_EXPIRY_SECONDS=300        # 5 minutes
OTP_MAX_VERIFY_ATTEMPTS=5     # max wrong guesses per OTP
OTP_MAX_RESEND_PER_HOUR=5     # max resends per email per 60 min window
OTP_RESEND_COOLDOWN_SECONDS=30 # min gap between consecutive resends

# SQLite DB path (relative to backend/)
DATABASE_URL=sqlite:///otp_auth.db
